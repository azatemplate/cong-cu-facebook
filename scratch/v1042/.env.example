# ============================================================
# Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!
# ============================================================

# Database
DB_HOST=db
DB_NAME=facebooksever
DB_USER=facebooksever
DB_PASS=your_secure_db_password_here

# Docker MySQL Root Password
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# Encryption Key (32+ characters, mix of letters, numbers, symbols)
# CRITICAL: change this before first deployment. All encrypted tokens depend on this key.
ENCRYPTION_KEY=change_me_to_a_random_32_char_string!

# Application Environment: 'development' or 'production'
APP_ENV=production
