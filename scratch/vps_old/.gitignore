# Ignore data folders
uploads/
db_data/

# Ignore Logs and lock files
*.log
*.lock
docker_logs/
error_log

# IDE
.idea/
.vscode/

# Ignore Env (CRITICAL: never commit credentials)
.env

# Ignore large archives
*.zip
*.tar.gz

# Ignore database dumps (CRITICAL: contain sensitive data)
*.sql
*.sql.gz
*.sql.bz2

# Ignore rate limit data
uploads/rate_limits/

# Ignore session data
uploads/sessions/

# Ignore cache data
uploads/cache/
