# ============================================================
# Security-hardened .htaccess for Facebook Automation Platform
# ============================================================

# ── Session Configuration ─────────────────────────────────────────────────────
# php_value session.save_path is set in .user.ini for CGI/FPM compatibility

# ── Block Access to Sensitive Files ───────────────────────────────────────────

# Block .env files (credentials)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block .git directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]
</IfModule>

# Block .user.ini
<FilesMatch "^\.user\.ini$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block SQL dump files
<FilesMatch "\.(sql|sql\.gz|sql\.bz2)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block log files and error_log
<FilesMatch "(^error_log$|\.log$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block backup/archive files
<FilesMatch "\.(zip|tar|tar\.gz|bak|old|orig|swp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block shell scripts
<FilesMatch "\.(sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block Dockerfile and docker-compose
<FilesMatch "^(Dockerfile|docker-compose\.yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block README and documentation
<FilesMatch "^README\.md$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Protect Directories ──────────────────────────────────────────────────────

# Disable directory listing
Options -Indexes

# ── Prevent PHP execution in uploads directory ────────────────────────────────
# (Handled by uploads/.htaccess if needed)

# ── Additional Security Headers (Apache level) ───────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
